{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Testar o tema",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/exemplos"
      ]
    },
    {
      "name": "Tirar prints (sem outras extensões)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extensions",
        "${workspaceFolder}/exemplos"
      ]
    }
  ]
}
