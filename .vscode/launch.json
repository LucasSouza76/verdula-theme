{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Test the theme",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/examples"
      ]
    },
    {
      "name": "Take screenshots (no other extensions)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extensions",
        "${workspaceFolder}/examples"
      ]
    }
  ]
}
