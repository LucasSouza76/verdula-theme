  "tokenColors": [
    {
      "name": "Default text",
      "scope": ["source", "text", "variable", "meta.definition.variable"],
      "settings": { "foreground": "#F3F2F6" }
    },
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": { "foreground": "#8F8AA1", "fontStyle": "italic" }
    },
    {
      "name": "Tags in comments (TODO, @param)",
      "scope": ["comment keyword", "comment storage.type", "storage.type.class.jsdoc", "punctuation.definition.block.tag.jsdoc"],
      "settings": { "foreground": "#B3B0C0", "fontStyle": "italic bold" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"],
      "settings": { "foreground": "#B5DD6E" }
    },
    {
      "name": "Escapes and interpolation",
      "scope": ["constant.character.escape", "punctuation.definition.template-expression", "punctuation.section.embedded"],
      "settings": { "foreground": "#E3809B" }
    },
    {
      "name": "Regex",
      "scope": ["string.regexp"],
      "settings": { "foreground": "#EF6F6C" }
    },
    {
      "name": "Numbers and constants",
      "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other", "variable.other.constant", "support.constant"],
      "settings": { "foreground": "#E5B567" }
    },
    {
      "name": "Keywords and operators",
      "scope": ["keyword", "keyword.control", "keyword.operator", "storage", "storage.modifier", "keyword.operator.new", "keyword.operator.expression"],
      "settings": { "foreground": "#E3809B" }
    },
    {
      "name": "Storage types (const, let, function, class)",
      "scope": ["storage.type", "keyword.declaration"],
      "settings": { "foreground": "#E3809B", "fontStyle": "italic" }
    },
    {
      "name": "Functions",
      "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function", "variable.function"],
      "settings": { "foreground": "#5BD98C" }
    },
    {
      "name": "Classes and types",
      "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type", "entity.other.inherited-class", "entity.name.namespace"],
      "settings": { "foreground": "#4CC9A6" }
    },
    {
      "name": "Primitive types",
      "scope": ["support.type.primitive", "support.type.builtin", "storage.type.primitive"],
      "settings": { "foreground": "#4CC9A6", "fontStyle": "italic" }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter", "meta.parameters variable"],
      "settings": { "foreground": "#A79BE3", "fontStyle": "italic" }
    },
    {
      "name": "this / self",
      "scope": ["variable.language", "variable.language.this", "variable.language.self", "variable.language.special.self"],
      "settings": { "foreground": "#E5B567", "fontStyle": "italic" }
    },
    {
      "name": "Object properties",
      "scope": ["variable.other.property", "variable.other.object.property", "meta.object-literal.key", "support.variable.property"],
      "settings": { "foreground": "#F3F2F6" }
    },
    {
      "name": "Decorators and annotations",
      "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.decorator", "storage.type.annotation"],
      "settings": { "foreground": "#5BD98C", "fontStyle": "italic" }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator"],
      "settings": { "foreground": "#F3F2F6" }
    },
    {
      "name": "HTML/JSX: tags",
      "scope": ["entity.name.tag", "meta.tag.sgml", "punctuation.definition.tag"],
      "settings": { "foreground": "#E3809B" }
    },
    {
      "name": "HTML/JSX: components",
      "scope": ["support.class.component", "entity.name.tag.component"],
      "settings": { "foreground": "#4CC9A6" }
    },
    {
      "name": "HTML/JSX: attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#5BD98C", "fontStyle": "italic" }
    },
    {
      "name": "CSS: class and id selectors",
      "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css", "entity.other.attribute-name.pseudo-class", "entity.other.attribute-name.pseudo-element"],
      "settings": { "foreground": "#5BD98C", "fontStyle": "" }
    },
    {
      "name": "CSS: properties",
      "scope": ["support.type.property-name", "meta.property-name"],
      "settings": { "foreground": "#4CC9A6" }
    },
    {
      "name": "CSS: values and units",
      "scope": ["support.constant.property-value", "keyword.other.unit", "constant.other.color"],
      "settings": { "foreground": "#E5B567" }
    },
    {
      "name": "JSON: keys",
      "scope": ["support.type.property-name.json"],
      "settings": { "foreground": "#4CC9A6" }
    },
    {
      "name": "Markdown: headings",
      "scope": ["markup.heading", "markup.heading entity.name", "punctuation.definition.heading.markdown"],
      "settings": { "foreground": "#5BD98C", "fontStyle": "bold" }
    },
    {
      "name": "Markdown: bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#E8925F", "fontStyle": "bold" }
    },
    {
      "name": "Markdown: italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#B5DD6E", "fontStyle": "italic" }
    },
    {
      "name": "Markdown: code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block", "markup.raw"],
      "settings": { "foreground": "#5BD98C" }
    },
    {
      "name": "Markdown: links",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#4CC9A6" }
    },
    {
      "name": "Markdown: quotes",
      "scope": ["markup.quote"],
      "settings": { "foreground": "#B3B0C0", "fontStyle": "italic" }
    },
    {
      "name": "Markdown: lists",
      "scope": ["punctuation.definition.list.begin.markdown", "beginning.punctuation.definition.list.markdown"],
      "settings": { "foreground": "#5BD98C" }
    },
    {
      "name": "Diff: inserted",
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#5BD98C" }
    },
    {
      "name": "Diff: deleted",
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#EF6F6C" }
    },
    {
      "name": "Diff: changed",
      "scope": ["markup.changed"],
      "settings": { "foreground": "#E8925F" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#EF6F6C", "fontStyle": "underline" }
    },
    {
      "name": "Deprecated",
      "scope": ["invalid.deprecated"],
      "settings": { "foreground": "#E8925F", "fontStyle": "strikethrough" }
    }
  ],

  "semanticTokenColors": {
    "namespace": "#4CC9A6",
    "class": "#4CC9A6",
    "interface": { "foreground": "#4CC9A6", "italic": true },
    "enum": "#4CC9A6",
    "enumMember": "#E5B567",
    "type": "#4CC9A6",
    "typeParameter": { "foreground": "#4CC9A6", "italic": true },
    "function": "#5BD98C",
    "method": "#5BD98C",
    "parameter": { "foreground": "#A79BE3", "italic": true },
    "property": "#F3F2F6",
    "variable": "#F3F2F6",
    "decorator": { "foreground": "#5BD98C", "italic": true },
    "*.deprecated": { "strikethrough": true }
  }
}
